{
  "seed": 42,
  "cv_folds": 3,
  "n_jobs": 1,
  "min_samples": 10000,
  "bootstrap_repeats": 1000,
  "features": {
    "max_features": 40000,
    "ngram_range": [
      1,
      2
    ],
    "min_df": 3,
    "max_df": 0.98,
    "sublinear_tf": true
  },
  "models": {
    "multinomial_nb": {
      "clf__alpha": [
        0.5,
        1.0
      ]
    },
    "logistic_regression": {
      "clf__C": [
        0.5,
        2.0
      ]
    },
    "linear_svm": {
      "clf__C": [
        0.5,
        2.0
      ]
    }
  }
}